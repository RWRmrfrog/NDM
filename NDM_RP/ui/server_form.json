{
  "namespace": "server_form",

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'ndm:') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "ndm_long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [ "100% - 15px", 10 ],
    "$title_max_size": [ "100% - 15px", 10 ],
    "size": [300, 90],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 15],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.ndm_long_form_panel",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'ndm:') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "ndm_long_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
        {
        "ndm_long_form_scrolling_content@server_form.ndm_long_form_scrolling_content": {}
        }
    ]
  },
  "ndm_long_form_scrolling_content": {
    "type": "stack_panel",
    "size": [ "100% - 4px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "label_offset_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "main_label": {
                "type": "label",
                "offset": [2,2],
                "color": "$main_header_text_color",
                "size": ["100%", "default"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text"
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [ "100%", 4 ]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "ndm_long_form_dynamic_buttons_panel@server_form.ndm_long_form_dynamic_buttons_panel": {}
            }
          ]
        }
      }
    ]
  },

  "ndm_long_form_dynamic_buttons_panel": {
    "type": "stack_panel",
    "size": ["100%c", "100%c"],
    "orientation": "horizontal",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.ndm_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "ndm_dynamic_button": {
    "type": "stack_panel",
    "size": [32, 32],
    "offset": [2, 0],
    "orientation": "horizontal",
    "controls": [
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "fill", 32 ],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 20 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "main_screen_content": {
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ndm_long_form_instance@server_form.ndm_long_form": {}
          }
        ]
      }
    ]
  }
}